            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD_UN_TITLE" LONG-NAME="title">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STR</DATATYPE-DEFINITION-STRING-REF></TYPE>
