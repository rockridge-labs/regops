            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD_SR_TITLE" LONG-NAME="title">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STR</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="AD_SR_PRIO" LONG-NAME="priority">
              <TYPE><DATATYPE-DEFINITION-ENUMERATION-REF>DT_ENUM</DATATYPE-DEFINITION-ENUMERATION-REF></TYPE>
            </ATTRIBUTE-DEFINITION-ENUMERATION>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT_TC" LONG-NAME="Test Case">
          <SPEC-ATTRIBUTES/>
        </SPEC-OBJECT-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="SO_UN_001">
          <VALUES/>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT_UN</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO_SR_001">
          <VALUES/>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT_SR</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO_SR_002">
          <VALUES/>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT_SR</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO_TC_001">
          <VALUES/>
          <TYPE><SPEC-OBJECT-TYPE-REF>SOT_TC</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
