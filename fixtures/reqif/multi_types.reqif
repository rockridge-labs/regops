  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT_STR" LONG-NAME="String"/>
        <DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="DT_ENUM" LONG-NAME="Enum"/>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT_UN" LONG-NAME="User Story">
