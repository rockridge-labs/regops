<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT_STR" LONG-NAME="String"/>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="SOT_DOORS_REQ" LONG-NAME="DOORS Requirement">
          <SPEC-ATTRIBUTES/>
        </SPEC-OBJECT-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="SPEC_T" LONG-NAME="Module"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <!-- SPEC-OBJECT without its own <TYPE> — DOORS-style indirect typing. -->
        <SPEC-OBJECT IDENTIFIER="SO_INDIRECT_001">
          <VALUES/>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SO_INDIRECT_002">
          <VALUES/>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPEC_M1" LONG-NAME="Module 1">
          <TYPE><SPECIFICATION-TYPE-REF>SPEC_T</SPECIFICATION-TYPE-REF></TYPE>
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="SH_1">
              <TYPE><SPEC-OBJECT-TYPE-REF>SOT_DOORS_REQ</SPEC-OBJECT-TYPE-REF></TYPE>
              <OBJECT><SPEC-OBJECT-REF>SO_INDIRECT_001</SPEC-OBJECT-REF></OBJECT>
            </SPEC-HIERARCHY>
            <SPEC-HIERARCHY IDENTIFIER="SH_2">
              <TYPE><SPEC-OBJECT-TYPE-REF>SOT_DOORS_REQ</SPEC-OBJECT-TYPE-REF></TYPE>
              <OBJECT><SPEC-OBJECT-REF>SO_INDIRECT_002</SPEC-OBJECT-REF></OBJECT>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
